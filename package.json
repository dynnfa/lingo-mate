{
  "name": "lingo-mate",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "speech:smoke": "node scripts/speech-runtime-smoke.mjs",
    "speech:test": "electron-vite build && vitest run --config vitest.speech.config.ts",
    "test:electron": "npm run build && npm run agent:build && playwright test tests/e2e",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && npm run agent:build && electron-builder --dir",
    "build:win": "npm run build && npm run agent:build && electron-builder --win",
    "build:mac": "electron-vite build && npm run agent:build && electron-builder --mac",
    "build:linux": "electron-vite build && npm run agent:build && electron-builder --linux",
    "agent:sync": "uv sync --project agent-engine --locked",
    "agent:protocol": "node --experimental-strip-types scripts/agent-protocol-schema.mjs --check",
    "agent:test": "uv run --project agent-engine --locked pytest -c agent-engine/pyproject.toml",
    "agent:check": "uv run --project agent-engine --locked ruff check agent-engine/src agent-engine/build && uv run --project agent-engine --locked ruff format --check agent-engine/src agent-engine/build && uv run --project agent-engine --locked mypy --config-file agent-engine/pyproject.toml agent-engine/src/lingo_agent",
    "agent:build": "uv run --project agent-engine --locked python agent-engine/build/build_runtime.py",
    "agent:smoke": "uv run --project agent-engine --locked python agent-engine/build/smoke_runtime.py"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "4.0.0",
    "@met4citizen/headtts": "1.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "openai": "^7.9.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "saxes": "^6.0.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
